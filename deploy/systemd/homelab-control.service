[Unit]
Description=Telegram homelab administration bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/homelab-telegram-bots/apps/control-bot
EnvironmentFile=%h/.config/homelab-bots/control.env
ExecStart=%h/homelab-telegram-bots/.venv/bin/python bot.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
