# Copy outside Git, or to .env for local shell use. No secrets are preconfigured.
SIGNAL_ENGINE=intraday-shadow
DRY_RUN=true
SYMBOL=XAUUSD
MARKET_SOURCE=exness
MARKET_DB=state/market-exness.db
MARKET_SCHEDULE_FILE=state/exness-schedule.json
INTRADAY_SHADOW_DB=state/shadow.db
TRADES_DB=state/trades.db
NEWS_DB=state/news.db
BOT_HEALTH_PORT=18766
PARITY_APPROVED=false
RELEASE1_PARITY_APPROVED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# An exact config hash is required separately for intraday-live.
INTRADAY_DEPLOY_CONFIG_HASH=
EXNESS_MARKET_DB=state/market-exness.db
EXNESS_TRANSPORT_COMMAND='["node", "exness_transport.mjs"]'
EXNESS_CREDENTIAL_DIR=/absolute/path/to/private/exness-credentials
FRED_API_KEY=
